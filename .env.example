APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `sync`, NOT `database`.
#
# This host has no worker process, so a queued job would be written to the table and never
# run — and the symptom is a silent no-op rather than an error. `sync` executes the work
# inline instead. Nothing dispatches jobs today; the setting is pinned now so the day
# somebody adds one, it works rather than disappearing.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production only — see docs/deployment.md
# ---------------------------------------------------------------------------

# Which proxy's forwarded headers to trust, or unset for none.
#
# Leave unset when this host terminates HTTPS itself. Set to `*` (or the proxy's
# CIDR range) when a proxy or CDN sits in front, or PHP sees HTTPS requests as
# plain HTTP: signed photo URLs are generated over http, redirect to https, and
# fail validation — so every staff photograph returns 403 while the console and
# the API work perfectly.
#
# NOTE: on the server this must be set in the REAL environment (cPanel cron and
# the PHP-FPM pool), not only here. With `config:cache` in place `.env` is not read
# on a request, so `bootstrap/app.php` would see null and the setting would appear
# to do nothing.
# TRUSTED_PROXIES=*

# SSO: shared with the ordering system. Must match on both sides.
# SSO_SIGNING_KEY=
# SSO_ORDERING_URL=https://ordering.example.com

# Business timezone. The app stores UTC and reports in this zone.
ATTENDANCE_TIMEZONE=Asia/Kuala_Lumpur
